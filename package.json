    "build:windows": "powershell.exe -NoProfile -File scripts/build-windows.ps1"
  },
  "dependencies": {
    "playwright": "1.64.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
