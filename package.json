{
  "name": "yisama-infinite-assistant",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "setup": "node scripts/yisama.mjs setup",
